[
  {
    "name": "annual after today's date with a skipped year",
    "first": "2020-11-05",
    "from": "2026-11-06",
    "frequency": "monthly",
    "interval": 12,
    "excluded": ["2029-11-05"],
    "until": "2032-11-05",
    "expected": [
      "2027-11-05",
      "2028-11-05",
      "2030-11-05",
      "2031-11-05",
      "2032-11-05"
    ]
  },
  {
    "name": "February 29 only in leap years",
    "first": "2024-02-29",
    "from": "2025-01-01",
    "frequency": "monthly",
    "interval": 12,
    "expected": [
      "2028-02-29",
      "2032-02-29",
      "2036-02-29",
      "2040-02-29",
      "2044-02-29"
    ]
  },
  {
    "name": "custom two-year interval",
    "first": "2024-08-31",
    "from": "2026-09-01",
    "frequency": "monthly",
    "interval": 24,
    "expected": [
      "2028-08-31",
      "2030-08-31",
      "2032-08-31",
      "2034-08-31",
      "2036-08-31"
    ]
  },
  {
    "name": "month-end skips missing dates",
    "first": "2026-01-31",
    "from": "2026-02-01",
    "frequency": "monthly",
    "interval": 1,
    "expected": [
      "2026-03-31",
      "2026-05-31",
      "2026-07-31",
      "2026-08-31",
      "2026-10-31"
    ]
  },
  {
    "name": "alternate weeks from a midweek anchor",
    "first": "2026-11-04",
    "from": "2026-11-06",
    "frequency": "weekly",
    "interval": 2,
    "weekdays": [1, 3],
    "expected": [
      "2026-11-16",
      "2026-11-18",
      "2026-11-30",
      "2026-12-02",
      "2026-12-14"
    ]
  },
  {
    "name": "daily interval differs from a calendar year",
    "first": "2026-11-06",
    "from": "2026-11-07",
    "frequency": "daily",
    "interval": 365,
    "expected": [
      "2027-11-06",
      "2028-11-05",
      "2029-11-05",
      "2030-11-05",
      "2031-11-05"
    ]
  },
  {
    "name": "individual dates respect skip and inclusive end",
    "first": "2026-11-05",
    "from": "2026-11-06",
    "frequency": "dates",
    "interval": 1,
    "dates": ["2026-11-05", "2027-02-01", "2027-02-09", "2027-05-20"],
    "excluded": ["2027-02-09"],
    "until": "2027-05-20",
    "expected": ["2027-02-01", "2027-05-20"]
  },
  {
    "name": "daily preview stays inside the supported year range",
    "first": "9999-12-30",
    "from": "9999-12-30",
    "frequency": "daily",
    "interval": 1,
    "expected": ["9999-12-30", "9999-12-31"]
  }
]
