<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@id/calendar_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_action">
 <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
  <TextView android:id="@id/calendar_previous" android:layout_width="40dp" android:layout_height="40dp" android:text="‹" android:textSize="26sp" android:gravity="center" android:contentDescription="Previous week"/>
  <TextView android:id="@id/calendar_month" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="This week" android:gravity="center" android:textStyle="bold" android:textSize="17sp"/>
  <TextView android:id="@id/calendar_next" android:layout_width="40dp" android:layout_height="40dp" android:text="›" android:textSize="26sp" android:gravity="center" android:contentDescription="Next week"/>
 </LinearLayout>
 <TextView android:id="@+id/week_legend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Midnight → noon → midnight · blocks show busy time" android:textSize="10sp" android:paddingBottom="4dp"/>
 <LinearLayout android:id="@+id/week_days" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
  <TextView android:id="@id/calendar_today" android:layout_width="74dp" android:layout_height="40dp" android:text="This week" android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
  <TextView android:id="@id/calendar_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="Show schedule" android:gravity="center" android:textSize="11sp"/>
 </LinearLayout>
</LinearLayout>
