[Unit]
Description=Field Notes private household workspace
After=network.target
[Service]
Type=simple
User=fieldnotes
Group=fieldnotes
ExecStart=/opt/field-notes/field-notes-server serve --data /var/lib/field-notes --key-file /etc/field-notes/master.key --origin https://notes.home.arpa
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/field-notes
LimitCORE=0
[Install]
WantedBy=multi-user.target
