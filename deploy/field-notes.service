[Unit]
Description=Field Notes private household workspace (containers)
After=network-online.target docker.service
Requires=docker.service
[Service]
Type=simple
User=root
Group=root
Environment=DOCKER_CONFIG=/etc/field-notes/docker
ExecStart=/usr/bin/python3 -B /opt/field-notes/container-runtime.py run --config /etc/field-notes/deployment.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=70
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_CHOWN
ReadWritePaths=/run/field-notes-peers
RuntimeDirectory=field-notes-peers
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
LimitCORE=0
[Install]
WantedBy=multi-user.target
